    <item>
      <guid isPermaLink="true">https://mastodon.gamedev.place/@djlink/117195322626694919</guid>
      <link>https://mastodon.gamedev.place/@djlink/117195322626694919</link>
      <pubDate>Tue, 01 Sep 2026 10:31:47 +0000</pubDate>
      <description>&lt;p&gt;Sometimes I wonder what would have happened if HD-DVD had won against Blu-ray format. DVDs were always super easy to use but Blu-ray was always a bit messier on codecs size, expensive players. But technically there are superior to HD-DVD.&lt;/p&gt;</description>
      <media:content url="https://cdn.masto.host/mastodongamedevplace/media_attachments/files/117/195/322/568/398/889/original/ec3c11a9f9610ab7.jpeg" type="image/jpeg" fileSize="24884" medium="image">
        <media:rating scheme="urn:simple">nonadult</media:rating>
        <media:description type="plain">An Xbox 360 had dvd player </media:description>
      </media:content>
      <media:content url="https://cdn.masto.host/mastodongamedevplace/media_attachments/files/117/195/322/577/338/733/original/07bbf1ad4b5a30bc.jpeg" type="image/jpeg" fileSize="16460" medium="image">
        <media:rating scheme="urn:simple">nonadult</media:rating>
        <media:description type="plain">A PlayStation 3 showing a Blu-ray Disc </media:description>
      </media:content>
    </item>

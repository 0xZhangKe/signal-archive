        <media:rating scheme="urn:simple">nonadult</media:rating>
        <media:description type="plain">A Nintendo Switch 2 playing the game Quest of Dungeons, showing the game using dual joycon mode and switching to mouse more where it's possible to use menus and attack monsters</media:description>
      </media:content>
